# 問題ごとに変わる値。このテンプレートを deploy.env に写し、当日、サーバーの実物（systemd の unit、webapp の中身）を見て埋める。
# 何を見れば決まるかは README の「問題に合わせる」。空の値を残したまま ./deploy や join.sh を実行すると止まる。

# アプリ
APP_USER=isucon
APP_SERVICE=""                              # 例: isupipe-go.service。join.sh がほかの台でアプリを止めて起動し直すのにも使う
APP_DIR="$REPO_DIR/webapp/go"              # 取得したリポジトリをそのままビルド・実行する
APP_BINARY=""                               # 例: "$APP_DIR/isupipe"
GO_BIN_DIR=/home/isucon/local/golang/bin    # go コマンドのある場所（sudo -iu isucon which go で確かめる）
BUILD_CMD=""                                # 例: "go build -buildvcs=true -o isupipe ."
# 再起動の後、このURL が何か返す（404 でもよい）まで待ってから成功とする。空なら 2 秒後に systemd の状態だけを見る
APP_HEALTH_URL=""                           # 例: http://127.0.0.1:8080/
APP_START_TIMEOUT=30

# MySQL（sqldef の接続先は、そのサーバー自身の MySQL）
MYSQL_SERVICE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isucon
DB_PASS=isucon
DB_NAME=""
# sqldef に渡すスキーマ。デプロイするリポジトリ内の定義を使う（空なら sqldef の段を飛ばす）
SCHEMA_FILE=""                              # 例: "$REPO_DIR/webapp/sql/initdb.d/10_schema.sql"

# ログの場所（./bench が使う）。base-conf が決める場所なので、普通は変えない
NGINX_ACCESS_LOG=/var/log/nginx/access.log
MYSQL_SLOW_LOG=/var/log/mysql/mysql-slow.log

# collect-conf.sh がリポジトリの conf/ に集めるもの（ディレクトリなら中のファイルすべて）。
# アプリの unit と、アプリが読む環境変数のファイル、ほかのミドルウェアの設定を足す
COLLECT_PATHS=(
  /etc/nginx/nginx.conf
  /etc/nginx/conf.d
  /etc/nginx/sites-available
  /etc/nginx/sites-enabled
  /etc/mysql/mysql.conf.d
)
