# 問題ごとに変わる値。当日、サーバーの実物（systemd の unit、webapp の中身）を見て書き換える。
# 下の値は isucon13 の想定で、確かめていない。

# アプリ
APP_USER=isucon
APP_DIR=/home/isucon/webapp/go              # go build を実行するディレクトリ
GO_BIN_DIR=/home/isucon/local/golang/bin    # go コマンドのある場所（which go で確かめる）
BUILD_CMD="go build -o isupipe ."
APP_SERVICE=isupipe-go.service
# 再起動の後、このURL が何か返す（404 でもよい）まで待ってから成功とする。空なら 2 秒後に systemd の状態だけを見る
APP_HEALTH_URL=""                           # 例: http://127.0.0.1:8080/
APP_START_TIMEOUT=30

# MySQL（sqldef の接続先は、そのサーバー自身の MySQL）
MYSQL_SERVICE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isucon
DB_PASS=isucon
DB_NAME=isupipe
# sqldef に渡すスキーマ。デプロイするリポジトリ内の定義を使う（空なら sqldef の段を飛ばす）
SCHEMA_FILE="$REPO_DIR/webapp/sql/initdb.d/10_schema.sql"

# ログの場所（./bench が使う）
NGINX_ACCESS_LOG=/var/log/nginx/access.log
MYSQL_SLOW_LOG=/var/log/mysql/mysql-slow.log

# collect-conf.sh がリポジトリの conf/ に集めるもの（ディレクトリなら中のファイルすべて）
COLLECT_PATHS=(
  /etc/nginx/nginx.conf
  /etc/nginx/conf.d
  /etc/nginx/sites-available
  /etc/nginx/sites-enabled            # isupipe.conf はリンクではなく実体
  /etc/mysql/mysql.conf.d
  /etc/systemd/system/isupipe-go.service
  /home/isucon/env.sh
)
